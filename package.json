{
  "name": "a11ysnap",
  "version": "0.1.0",
  "type": "module",
  "description": "Accessibility audit crawler — crawl a site and run WCAG 2.1 checks on every page",
  "bin": {
    "a11ysnap": "./bin/a11ysnap.js"
  },
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "test:fast": "node --test test/config.test.js test/url-utils.test.js test/crawler.test.js test/reporter.test.js test/pipeline.test.js test/worker.test.js",
    "test:browser": "ALLYSNAP_BROWSER_TESTS=1 node --test test/auditor.test.js",
    "worker": "node src/worker/index.js",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev"
  },
  "keywords": [
    "accessibility",
    "wcag",
    "a11y",
    "audit",
    "crawler"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ora": "^9.3.0",
    "playwright": "^1.58.2"
  }
}
